<Window x:Class="AUTOAIMLOCK.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AUTOAIMLOCK.App.ViewModels"
        Title="AUTOAIMLOCK" Width="860" Height="640"
        ResizeMode="NoResize" SizeToContent="Manual"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top accent line -->
        <Border Grid.RowSpan="3" Height="2" VerticalAlignment="Top" CornerRadius="1" Margin="-18,-18,-18,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0000E676" Offset="0" />
                    <GradientStop Color="#FF00E676" Offset="0.3" />
                    <GradientStop Color="#FF00E676" Offset="0.7" />
                    <GradientStop Color="#0000E676" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ═══ HEADER ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="AUTOAIMLOCK" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="  screen-based aim enhancement" Foreground="{StaticResource Muted}"
                           FontSize="12" VerticalAlignment="Center" Margin="8,2,0,0" />
                <Border CornerRadius="4" Background="{StaticResource AccentTint}" BorderBrush="{StaticResource Accent}"
                        BorderThickness="1" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="FREE PLAN" Foreground="{StaticResource Accent}" FontSize="10"
                               FontWeight="Bold" FontFamily="Cascadia Mono" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="4" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" Padding="5,1" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="F8" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"
                               FontFamily="Cascadia Mono" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="ASSIST" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Border CornerRadius="6" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Ok}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <CheckBox IsChecked="{Binding Enabled}" Content="Enabled" Foreground="{StaticResource Text}"
                                  VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══ BODY ═══ -->
        <TabControl Grid.Row="1">
            <!-- DASHBOARD TAB -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              StrokeThickness="1.5" Fill="Transparent" Margin="0,0,6,0"
                              Data="M 2 12 L 2 8 M 6 12 L 6 5 M 10 12 L 10 9 M 14 12 L 14 2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="Dashboard" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Live stats tiles -->
                        <WrapPanel Margin="0,0,0,14">
                            <Border Style="{StaticResource Card}" Margin="0,0,14,0" MinWidth="140">
                                <StackPanel>
                                    <TextBlock Text="FPS" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Fps}" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource Accent}" FontFamily="Cascadia Mono" />
                                    <TextBlock Text="frames/sec" Foreground="{StaticResource Muted}" FontSize="10" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,14,0" MinWidth="140">
                                <StackPanel>
                                    <TextBlock Text="TARGET" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Danger}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TargetLocked}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource Ok}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding TargetLocked, Converter={x:Static vm:BoolToTextConverter.Instance}}"
                                                   FontSize="16" FontWeight="Bold" FontFamily="Cascadia Mono" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TargetDistance, StringFormat={}{0} px from center}"
                                               Foreground="{StaticResource Muted}" FontSize="10" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" MinWidth="140">
                                <StackPanel>
                                    <TextBlock Text="STATUS" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Enabled, Converter={x:Static vm:BoolToTextConverter.Instance}}"
                                               FontSize="16" FontWeight="Bold" FontFamily="Cascadia Mono"
                                               Foreground="{StaticResource Accent}" />
                                    <TextBlock Text="press F8 to toggle" Foreground="{StaticResource Muted}" FontSize="10" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- FOV visualization -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Field of View" Style="{StaticResource SectionTitle}" />
                                <Canvas x:Name="FovCanvas" Height="240" Background="#FF0D1016"
                                        ClipToBounds="True" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Green circle = FOV radius. Red dot = last detected target center. Crosshair = screen center. The aim assist only tracks targets within the FOV circle." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- DETECTION TAB -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              StrokeThickness="1.5" Fill="Transparent" Margin="0,0,6,0"
                              Data="M 7 1 L 7 5 M 7 9 L 7 13 M 1 7 L 5 7 M 9 7 L 13 7 M 7 4 A 3 3 0 1 0 7 10 A 3 3 0 1 0 7 4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <TextBlock Text="Detection" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Quick game setup -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Quick Game Setup" Style="{StaticResource SectionTitle}" />
                                <WrapPanel>
                                    <TextBlock Text="Game profile:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Width="240" ItemsSource="{Binding GamePresetNames}"
                                              SelectedItem="{Binding SelectedGamePreset}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="One-click setup — applies optimal color, FOV, smoothing, algorithm, and min-pixel threshold for your game. Knives Out has 3 modes: hit marker (aim correction), nametag (squad), and damage numbers (active combat)." />
                            </StackPanel>
                        </Border>

                        <!-- Color presets -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Color Preset" Style="{StaticResource SectionTitle}" />
                                <WrapPanel>
                                    <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Width="180" ItemsSource="{Binding PresetNames}"
                                              SelectedItem="{Binding SelectedPreset}" />
                                    <TextBlock Text="Choose the color of your target's outline/health bar/model." 
                                               Foreground="{StaticResource Muted}" FontSize="11"
                                               VerticalAlignment="Center" Margin="14,0,0,0" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- HSV color range -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="HSV Color Range (advanced)" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Hue min (0-180)" VerticalAlignment="Center" />
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="180" Value="{Binding HMin}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding HMin}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Hue max (0-180)" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="180" Value="{Binding HMax}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding HMax}" VerticalAlignment="Center" Margin="10,8,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Sat min (0-255)" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding SMin}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SMin}" VerticalAlignment="Center" Margin="10,8,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sat max (0-255)" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding SMax}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding SMax}" VerticalAlignment="Center" Margin="10,8,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Val min (0-255)" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding VMin}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding VMin}" VerticalAlignment="Center" Margin="10,8,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Val max (0-255)" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding VMax}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding VMax}" VerticalAlignment="Center" Margin="10,8,0,0" FontFamily="Cascadia Mono" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                           Text="Tune these to match your target's color. Use the preset as a starting point, then fine-tune. Hue uses OpenCV's 0-180 scale (0=red, 60=green, 120=blue)." />
                            </StackPanel>
                        </Border>

                        <!-- Body detection (second band) — mid/long range lock -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Body Detection (mid/long range)" Style="{StaticResource SectionTitle}" />
                                <CheckBox Content="Detect enemy body (second color band)" IsChecked="{Binding DetectBody}" Margin="0,2,0,0" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="Detects the enemy character model itself, not just the hit marker. This lets the assist lock onto targets at mid/long range where the hit-marker flash is too small. Disable if it causes false locks on scenery." />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Hue min (0-180)" VerticalAlignment="Center" />
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="180" Value="{Binding BodyHMin}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding BodyHMin}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Hue max (0-180)" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="180" Value="{Binding BodyHMax}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding BodyHMax}" VerticalAlignment="Center" Margin="10,8,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Sat min (0-255)" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BodySMin}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding BodySMin}" VerticalAlignment="Center" Margin="10,8,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sat max (0-255)" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BodySMax}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding BodySMax}" VerticalAlignment="Center" Margin="10,8,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Val min (0-255)" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BodyVMin}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding BodyVMin}" VerticalAlignment="Center" Margin="10,8,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Val max (0-255)" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BodyVMax}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding BodyVMax}" VerticalAlignment="Center" Margin="10,8,0,0" FontFamily="Cascadia Mono" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Capture settings -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Capture &amp; Filtering" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Capture size (px)" VerticalAlignment="Center" />
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="100" Maximum="800" Value="{Binding CaptureSize}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CaptureSize, StringFormat={}{0} px}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Min target pixels" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="200" Value="{Binding MinTargetPixels}" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MinTargetPixels}" VerticalAlignment="Center" Margin="10,10,0,0" FontFamily="Cascadia Mono" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="Capture size = screen region around the crosshair (smaller = faster). Min target pixels filters out noise — increase if you get false positives." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- AIM TAB -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              StrokeThickness="1.5" Fill="Transparent" Margin="0,0,6,0"
                              Data="M 7 2 L 7 11 M 4 8 L 7 12 L 10 8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock Text="Aim" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Movement settings -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Movement" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Smoothing (0-100)" VerticalAlignment="Center" />
                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Smoothing}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Smoothing}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="FOV radius (px)" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <Slider Grid.Row="1" Grid.Column="1" Minimum="20" Maximum="400" Value="{Binding FovRadius}" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding FovRadius, StringFormat={}{0} px}" VerticalAlignment="Center" Margin="10,10,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Step delay (ms)" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="10" Value="{Binding StepDelayMs}" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding StepDelayMs, StringFormat={}{0} ms}" VerticalAlignment="Center" Margin="10,10,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Max move (px/frame)" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <Slider Grid.Row="3" Grid.Column="1" Minimum="1" Maximum="40" Value="{Binding MaxMovePx}" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding MaxMovePx, StringFormat={}{0} px}" VerticalAlignment="Center" Margin="10,10,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Deadzone (px)" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="10" Value="{Binding DeadzonePx}" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding DeadzonePx, StringFormat={}{0} px}" VerticalAlignment="Center" Margin="10,10,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Target lead (ms)" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding LeadMs}" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding LeadMs, StringFormat={}{0} ms}" VerticalAlignment="Center" Margin="10,10,0,0" FontFamily="Cascadia Mono" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Aim stability" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <Slider Grid.Row="6" Grid.Column="1" Minimum="0.0" Maximum="0.9" TickFrequency="0.01" Value="{Binding AimStability}" VerticalAlignment="Center" Margin="0,10,0,0" />
                                    <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding AimStability, StringFormat={}{0:0.00}}" VerticalAlignment="Center" Margin="10,10,0,0" FontFamily="Cascadia Mono" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="Smoothing: higher = smoother/slower aim, lower = snappier. FOV radius: only targets within this distance from the crosshair are tracked. Max move: hard cap per frame (lower = calmer, prevents wild flings). Deadzone: stop pushing once on target. Target lead: aims ahead of a moving target's velocity so the lock rides moving bodies (higher = more lead, better for strafing targets). Aim stability: smooths the detected target point frame-to-frame (higher = steadier, but slightly more lag)." />
                            </StackPanel>
                        </Border>

                        <!-- Trigger mode -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Trigger Mode" Style="{StaticResource SectionTitle}" />
                                <WrapPanel>
                                    <TextBlock Text="Activate when:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Width="180" ItemsSource="{Binding TriggerModes}"
                                              SelectedIndex="{Binding TriggerIndex}" />
                                </WrapPanel>
                                <CheckBox IsChecked="{Binding AutoLock}" Content="Auto-lock — engage automatically when a target is in FOV (no button needed)"
                                          Margin="0,8,0,0" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Right mouse hold = aim assist activates while holding right click (typical ADS). Toggle = press F8 to toggle on/off. Always on = continuous tracking. Auto-lock = the assist engages by itself the moment a valid target enters the FOV — holding a trigger button also always works and takes priority." />
                            </StackPanel>
                        </Border>

                        <!-- Movement algorithm -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Movement Algorithm" Style="{StaticResource SectionTitle}" />
                                <WrapPanel>
                                    <TextBlock Text="Algorithm:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox Width="200" ItemsSource="{Binding AlgorithmNames}"
                                              SelectedIndex="{Binding AlgorithmIndex}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="PID: fast, precise, low-latency tracking — best for FPS flick shots. WindMouse: physics-based model with gravity, wind, and friction — most natural human-like trajectories, ideal for TPS tracking and anti-detection." />
                            </StackPanel>
                        </Border>

                        <!-- Humanization -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Humanization" Style="{StaticResource SectionTitle}" />
                                <CheckBox IsChecked="{Binding Humanize}" Content="Enable movement jitter (anti-detection)" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Jitter (±px)" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="10" Value="{Binding JitterPx}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding JitterPx, StringFormat={}{0} px}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Cascadia Mono" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="Adds small random offsets to each mouse movement, making the aim pattern less robotic. Recommended for legitimate use." />
                            </StackPanel>
                        </Border>

                        <!-- Macros (no-recoil / rapid-fire) -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Macros (no-recoil / rapid-fire)" Style="{StaticResource SectionTitle}" />
                                <CheckBox IsChecked="{Binding EnableNoRecoil}" Content="Enable no-recoil (pull down while firing)" Margin="0,2,0,0" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Vertical pull (px)" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="10" Value="{Binding RecoilVertical}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding RecoilVertical, StringFormat={}{0} px}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Cascadia Mono" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Horizontal pull (px)" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="-10" Maximum="10" Value="{Binding RecoilHorizontal}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding RecoilHorizontal, StringFormat={}{0} px}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Cascadia Mono" />
                                </Grid>
                                <CheckBox IsChecked="{Binding EnableRapidFire}" Content="Enable rapid-fire (auto click while firing)" Margin="0,12,0,0" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Rapid-fire rate (RPM)" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="100" Maximum="1200" TickFrequency="50" Value="{Binding RapidFireRpm}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding RapidFireRpm, StringFormat={}{0} rpm}" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Cascadia Mono" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="No-recoil: compensating pull that counters the gun's upward kick so the lock stays stable. With rapid-fire ON the pull is applied per shot (px/shot). With rapid-fire OFF it is a smooth continuous drift while you hold fire (px/sec, with natural spread + micro-pauses). Rapid-fire: re-clicks at the set RPM while you hold fire (for semi/bolt weapons). Both only run while aim-assist is active with the fire button held." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- SETTINGS TAB -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                              StrokeThickness="1.5" Fill="Transparent" Margin="0,0,6,0"
                              Data="M 7 3 A 4 4 0 1 0 7 11 A 4 4 0 1 0 7 3 M 7 5.5 A 1.5 1.5 0 1 0 7 8.5 A 1.5 1.5 0 1 0 7 5.5" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Game-specific tuning guide -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Game Tuning Guide" Style="{StaticResource SectionTitle}" />

                                <!-- Knives Out -->
                                <Border CornerRadius="6" Background="#FF0D1016" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Knives Out" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                            <TextBlock Text="  NetEase · TPS Battle Royale · PC" FontSize="11" Foreground="{StaticResource Muted}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                                   Text="No built-in enemy outlines. Use 'Knives Out — Hit Marker' preset to detect red hit flashes when you're already hitting an enemy, or 'Knives Out — Nametag' to detect red nametags above enemies in squad mode." />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                                   Text="Recommended: WindMouse algorithm · Smoothing 55 · FOV 250px · Capture 500px · Humanize ON (2px jitter)" />
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="Tip: Knives Out runs on PC via NetEase client. Set game to borderless windowed mode in graphics settings for screen capture to work." />
                                    </StackPanel>
                                </Border>

                                <!-- PUBG -->
                                <Border CornerRadius="6" Background="#FF0D1016" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="PUBG" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                            <TextBlock Text="  TPS Battle Royale" FontSize="11" Foreground="{StaticResource Muted}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="Use 'PUBG — Hit Marker' preset. Same approach as Knives Out — no enemy outlines, detect hit markers. WindMouse · Smoothing 55-65 · FOV 250px." />
                                    </StackPanel>
                                </Border>

                                <!-- Valorant -->
                                <Border CornerRadius="6" Background="#FF0D1016" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Valorant" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                            <TextBlock Text="  FPS · Has enemy outlines" FontSize="11" Foreground="{StaticResource Muted}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="Has red enemy outlines — use 'Red (Enemy)' preset. PID algorithm · Smoothing 25-35 · FOV 120px · Right mouse hold trigger." />
                                    </StackPanel>
                                </Border>

                                <!-- Apex Legends -->
                                <Border CornerRadius="6" Background="#FF0D1016" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Apex Legends" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                            <TextBlock Text="  FPS · Red enemy outlines" FontSize="11" Foreground="{StaticResource Muted}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="Has red enemy outlines — use 'Red (Wide)' preset for broader detection. PID · Smoothing 30-40 · FOV 150px." />
                                    </StackPanel>
                                </Border>

                                <!-- Generic -->
                                <Border CornerRadius="6" Background="#FF0D1016" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" Padding="12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Other Games" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="For games without enemy outlines (like Knives Out, PUBG, Free Fire), use the 'Skin/White Tone' preset to detect player models, or tune HSV manually to match distinctive clothing/uniform colors. Always test in borderless windowed mode." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding AppInfo}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="Features: dual-band detection (body silhouette + hit-marker flash), velocity-lead moving-target lock, proportional anti-shake aiming, mid/long-range body lock, no-recoil and rapid-fire macros, and humanization." />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="Works with any game that runs in borderless/windowed mode (screen capture requires it). No GPU hooks, no game memory reading — purely visual detection." />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="Legal note: automated aim assistance may violate the terms of service of some games. Use responsibly — only on games and servers that allow assistive tools, or for accessibility purposes. Never for cheating in competitive play." />
                        </StackPanel>
                    </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="2" CornerRadius="8" Padding="14,8" Margin="0,14,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF14181F" Offset="0" />
                    <GradientStop Color="#FF0D1016" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Version, StringFormat=v{0}}" Foreground="#FF6B7585" FontSize="10"
                           FontFamily="Cascadia Mono" VerticalAlignment="Center" Margin="14,0,0,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Danger}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Ok}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="11.5"
                               FontFamily="Cascadia Mono" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="│" Foreground="#FF2A3444" FontSize="12" Margin="12,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Foreground="#FF6B7585" FontSize="11" FontFamily="Cascadia Mono" VerticalAlignment="Center">
                        <Run Text="FPS: " /><Run Text="{Binding Fps, Mode=OneWay}" Foreground="{StaticResource Accent}" />
                    </TextBlock>
                    <TextBlock Text="│" Foreground="#FF2A3444" FontSize="12" Margin="12,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Foreground="#FF6B7585" FontSize="11" FontFamily="Cascadia Mono" VerticalAlignment="Center">
                        <Run Text="Target: " />
                        <Run Text="{Binding TargetLocked, Converter={x:Static vm:BoolToTextConverter.Instance}, Mode=OneWay}" Foreground="{StaticResource Accent}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
