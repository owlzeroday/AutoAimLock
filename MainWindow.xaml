<Window x:Class="AutoAimLock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoAimLock" Width="560" Height="690" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#FF0B0E13" Foreground="#FFE2E8F0"
        FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="AUTOAIMLOCK" FontSize="17" FontWeight="Bold" Foreground="#FF00E676" />
                <TextBlock Text="  stability-first aim lock" Foreground="#FF6B7585" FontSize="11" VerticalAlignment="Center" Margin="8,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border CornerRadius="5" Background="#FF161E2D" BorderBrush="#FF1F2937" BorderThickness="1" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="#FFEF4444" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <CheckBox x:Name="EnabledCheck" Content="Enabled (F8)" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <!-- TARGET -->
            <Border Background="#FF111722" BorderBrush="#FF1F2937" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="TARGET COLOR" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,8,0" Width="90" />
                        <ComboBox x:Name="PresetCombo" Width="220" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" /><ColumnDefinition Width="170" /><ColumnDefinition Width="60" />
                            <ColumnDefinition Width="90" /><ColumnDefinition Width="170" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Hue min" VerticalAlignment="Center" />
                        <Slider  Grid.Row="0" Grid.Column="1" x:Name="HMin" Maximum="180" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="HMinV" FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Hue max" VerticalAlignment="Center" />
                        <Slider  Grid.Row="0" Grid.Column="4" x:Name="HMax" Maximum="180" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="5" x:Name="HMaxV" FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0,0,0" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sat min" VerticalAlignment="Center" />
                        <Slider  Grid.Row="1" Grid.Column="1" x:Name="SMin" Maximum="255" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SMinV" FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Sat max" VerticalAlignment="Center" />
                        <Slider  Grid.Row="1" Grid.Column="4" x:Name="SMax" Maximum="255" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="5" x:Name="SMaxV" FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Val min" VerticalAlignment="Center" />
                        <Slider  Grid.Row="2" Grid.Column="1" x:Name="VMin" Maximum="255" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="VMinV" FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Val max" VerticalAlignment="Center" />
                        <Slider  Grid.Row="2" Grid.Column="4" x:Name="VMax" Maximum="255" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="5" x:Name="VMaxV" FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                    <TextBlock Text="Pick the preset matching your target color, then fine-tune. Knives Out bots = 'Bot Body'." Foreground="#FF6B7585" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- LOCK -->
            <Border Background="#FF111722" BorderBrush="#FF1F2937" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="LOCK" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" /><ColumnDefinition Width="200" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="FOV radius (px)" VerticalAlignment="Center" />
                        <Slider  Grid.Row="0" Grid.Column="1" x:Name="Fov" Minimum="60" Maximum="300" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="FovV" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Lock gain (%)" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <Slider  Grid.Row="1" Grid.Column="1" x:Name="Gain" Minimum="5" Maximum="60" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="GainV" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Max step (px)" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <Slider  Grid.Row="2" Grid.Column="1" x:Name="MaxStep" Minimum="2" Maximum="15" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="MaxStepV" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Deadzone (px)" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <Slider  Grid.Row="3" Grid.Column="1" x:Name="Deadzone" Minimum="3" Maximum="15" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="3" x:Name="DeadzoneV" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Min pixels" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <Slider  Grid.Row="4" Grid.Column="1" x:Name="MinPixels" Minimum="6" Maximum="80" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="2" x:Name="MinPixelsV" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Foreground="#FF6B7585" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Gain = fraction of remaining distance per tick (lower = smoother, never overshoots). Max step caps speed. Deadzone holds the lock still on target with hysteresis — no hunting." />
                </StackPanel>
            </Border>

            <!-- MACROS -->
            <StackPanel Margin="0,0,0,6">
                <Grid>
                    <TextBlock Text="MACROS — NO-RECOIL + RAPID FIRE" FontSize="12" FontWeight="SemiBold" Foreground="#FF00E676" />
                    <TextBlock x:Name="ModeLabel" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="11" Foreground="#FFFB923C" Text="MODE: OFF" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Hold to fire macro:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="MacroKeyCombo" Width="180" />
                </StackPanel>
                <TextBlock Text="Set to Side Button 5 (default) to fire via the mouse side button — the tool drives LMB + recoil, like AegisMouse. Left mouse = fire macro runs while you hold LMB." Foreground="#FF6B7585" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#FF111722" BorderBrush="#FF1F2937" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <CheckBox x:Name="RecoilOn" Content="No-recoil (per-shot, AegisMouse model)" FontWeight="SemiBold" />
                        <TextBlock Text="Strength multiplier (×)" Margin="0,8,0,0" />
                        <Slider  x:Name="RecoilStrength" Minimum="0.1" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                        <TextBlock Text="Horizontal bias (px/shot)" Margin="0,6,0,0" />
                        <Slider  x:Name="RecoilHorizontal" Minimum="-10" Maximum="10" />
                        <TextBlock x:Name="RecoilVals" FontFamily="Consolas" FontSize="11" Foreground="#FF6B7585" Margin="0,4,0,0" />
                        <TextBlock Text="One pull per shot at your weapon's fire rate (RPM below). Base 3→10px through the spray × multiplier. Still climbing = raise ×. Drifting down = lower ×." Foreground="#FF6B7585" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#FF111722" BorderBrush="#FF1F2937" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <CheckBox x:Name="RapidOn" Content="Rapid fire" FontWeight="SemiBold" />
                        <TextBlock Text="Rate (RPM)" Margin="0,8,0,0" />
                        <Slider  x:Name="RapidRpm" Minimum="100" Maximum="1000" />
                        <TextBlock x:Name="RapidVals" FontFamily="Consolas" FontSize="11" Foreground="#FF6B7585" Margin="0,4,0,0" />
                        <TextBlock Text="Auto-clicks while you hold fire (semi/bolt weapons)." Foreground="#FF6B7585" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#FF0D1016" BorderBrush="#FF1F2937" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" FontFamily="Consolas" FontSize="11.5" Foreground="#FF6B7585" Text="OFF — no target" />
                <TextBlock Text="   │   " Foreground="#FF2A3444" FontSize="11" />
                <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#FF6B7585">
                    <Run Text="FPS: " /><Run x:Name="FpsText" Text="0" Foreground="#FF00E676" />
                </TextBlock>
                <TextBlock Text="   │   " Foreground="#FF2A3444" FontSize="11" />
                <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#FF6B7585">
                    <Run Text="Target: " /><Run x:Name="TargetText" Text="NONE" Foreground="#FF00E676" />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
